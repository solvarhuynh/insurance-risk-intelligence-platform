FROM python:3.12-slim
WORKDIR /app
COPY infra/requirements-dashboard.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt
COPY dashboard /app/dashboard
RUN useradd --create-home appuser
USER appuser
EXPOSE 8050
CMD ["gunicorn", "--bind", "0.0.0.0:8050", "--workers", "2", "--threads", "4", "--timeout", "60", "dashboard.app:server"]
