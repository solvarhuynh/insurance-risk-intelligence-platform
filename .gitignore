# Data files
data/raw/*
!data/raw/.gitkeep

# Credentials and environment variables
.env
*.env
*.pem
*.key
credentials.json
secrets/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Runtime ML artifacts are reproducible locally but binary outputs do not belong in Git.
ml/artifacts/*
!ml/artifacts/.gitkeep

# Local orchestration/runtime output; keep checkpoints and reports, exclude live logs.
log/scheduler/
log/dag_processor_manager/
log/dag_id=*/
reports/data/*.log

.cursor/*
!.cursor/rules/
!.cursor/rules/**

# Jupyter Notebooks
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# Airflow
logs/
airflow.cfg
airflow.db
unittests.cfg
*.log

# Operating System Files
.DS_Store
Thumbs.db
Desktop.ini


# Personal
roadmap.md
!docs/specs/roadmap.md

# Personal agent-session history; intentionally local only.
AGENT_PROMPT_HISTORY.md
.tmp-dependency-check-*/

# Local project guides and environment template.
FINAL_PROJECT_GUIDE.md
REPO_LEARNING_GUIDE.md
.env.example
